    "timing": {
      "time_zone": "Europe/London",
      "period": "week",
      "week_starts_on": "Mon",
      "plan_ahead": 2,
      "current_until": {
        "table": "promotion",
        "time": "ends_at"
      },
      "times": [
        {
          "table": "stock",
          "name": "counted_at",
          "day": "counted_day",
          "time": "counted_time",
          "role": "observation",
          "meaning": "Stock count time"
        },
        {
          "table": "deliveries",
          "name": "delivery_at",
          "day": "delivery_day",
          "time": "delivery_time",
          "role": "deadline",
          "meaning": "Supplier delivery time"
        },
        {
          "table": "deliveries",
          "name": "cutoff_at",
          "day": "cutoff_day",
          "time": "cutoff_time",
          "role": "deadline",
          "meaning": "Supplier cut-off time"
        },
        {
          "table": "promotion",
          "name": "scheduled_run_at",
          "day": "scheduled_run_day",
          "time": "scheduled_run_time",
          "role": "deadline",
          "meaning": "Scheduled run time"
        },
        {
          "table": "promotion",
          "name": "starts_at",
          "day": "starts_day",
          "time": "starts_time",
          "role": "deadline",
          "meaning": "Promotion starts time"
        },
        {
          "table": "promotion",
          "name": "ends_at",
          "day": "ends_day",
          "time": "ends_time",
          "role": "deadline",
          "meaning": "Promotion ends time"
        },
        {
          "table": "promotion",
          "name": "price_cutoff_at",
          "day": "price_cutoff_day",
          "time": "price_cutoff_time",
          "role": "deadline",
          "meaning": "Price cut-off time"
        }
      ],
      "source": {
        "cells": [
          "Promotion!O2"
        ],
        "quote": "The promotion runs every weekend, Saturday 07:00 to Sunday 22:00, UK time. Each run plans the coming weekend and the one after; a weekend counts as the coming one until its promotion ends. Stock counts and notes refer to their most recent occurrence before the run. Order cut-offs, deliveries and the price cut-off refer to the week of the weekend they are for."
      }
    },
    "items": [
      {
        "kind": "product",
        "label": "product",
        "table": "products",
        "key": "sku",
        "group": false
      },
      {
        "kind": "kit",
        "label": "kit",
        "table": "kit",
        "key": "kit_id",
        "group": true
      }
    ],
    "editable": [
      {
        "kind": "product",
        "name": "offer_price",
        "label": "offer price",
        "type": "money",
        "applies_when": "key in offers",
        "default": "offers[key].brief_offer_price",
        "source": {
          "cells": [
            "Changes!E3"
          ],
          "quote": "The promotional shelf price."
        }
      },
      {
        "kind": "product",
        "name": "order_units",
        "label": "order units",
        "type": "whole_number",
        "applies_when": "key in deliveries",
        "default": "0",
        "source": {
          "cells": [
            "Changes!E2"
          ],
          "quote": "Units to order as a final top-up for the weekend."
        }
      },
      {
        "kind": "kit",
        "name": "kit_price",
        "label": "kit price",
        "type": "money",
        "applies_when": "false",
        "default": "promotion.kit_brief_price",
        "source": {
          "cells": [
            "Changes!E4"
          ],
          "quote": "The price of the Avo toast kit."
        }
      },
      {
        "kind": "kit",
        "name": "kit_limit",
        "label": "kit limit",
        "type": "whole_number",
        "applies_when": "false",
        "default": "promotion.expected_kits",
        "source": {
          "cells": [
            "Changes!E5"
          ],
          "quote": "How many kits to put out over the weekend."
        }
      }
    ],
    "facts": [
      {
        "kind": "product",
        "name": "avg_sales",
        "label": "Average sales",
        "type": "double",
        "expr": "double(sales[key].weekend_1 + sales[key].weekend_2 + sales[key].weekend_3 + sales[key].weekend_4) / 4.0",
        "explain": "Average sales across four weekends"
      },
      {
        "kind": "kit",
        "name": "kit_cost",
        "label": "Kit component cost",
        "type": "int",
        "expr": "rows.map(r, products[r.component_sku].cost_price * r.quantity).sum()",
        "explain": "Total cost of components for the kit"
      }
    ],
    "rules": [
      {
        "id": "r1_margin_floor",
        "statement": "R1",
        "sheet_rule": "R1",
        "kind": "product",
        "title": "Margin Floor for Offer Price",
        "outcome": "block",
        "when": "key in offers",
        "assert": "!(key in offers) || (change.offer_price - row.cost_price) * 100 >= parameters[row.category].margin_floor_pct * change.offer_price",
        "explain": "Offer price must maintain the category margin floor percentage",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A2",
            "Rules!B2",
            "Rules!C2"
          ],
          "quote": "An offer price must keep at least the category's margin floor."
        }
      },
      {
        "id": "r2_kit_margin",
        "statement": "R2",
        "sheet_rule": "R2",
        "kind": "kit",
        "title": "Margin Floor for Kit Price",
        "outcome": "block",
        "when": "false",
        "assert": "(change.kit_price - facts.kit_cost) * 100 >= parameters['kit'].margin_floor_pct * change.kit_price",
        "explain": "Kit price must maintain the kit margin floor percentage over component costs",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A3",
            "Rules!B3",
            "Rules!C3"
          ],
          "quote": "The kit price must keep at least the kit margin floor, counting the cost of every component."
        }
      },
      {
        "id": "r3_whole_cases",
        "statement": "R3",
        "sheet_rule": "R3",
        "kind": "product",
        "title": "Whole Cases for Orders",
        "outcome": "block",
        "when": "key in deliveries",
        "assert": "!(key in deliveries) || (change.order_units % row.case_size == 0)",
        "explain": "Order quantities must be in whole cases",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A4",
            "Rules!B4",
            "Rules!C4"
          ],
          "quote": "Order quantities must be whole cases."
        }
      },
      {
        "id": "r4_stock_age",
        "statement": "R4",
        "sheet_rule": "R4",
        "kind": "product",
        "title": "Stock Count Age Limit",
        "outcome": "block",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && change.order_units > 0 && parameters[row.category].?max_count_age_hours.hasValue()) || (run_at - stock[key].counted_at).getHours() <= parameters[row.category].?max_count_age_hours.orValue(0)",
        "explain": "Stock count must not be older than the category maximum age limit if ordering",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A5",
            "Rules!B5",
            "Rules!C5"
          ],
          "quote": "Don't use a stock count older than the category's limit; recount first."
        }
      },
      {
        "id": "r5_delivery_before_start",
        "statement": "R5",
        "sheet_rule": "R5",
        "kind": "product",
        "title": "Delivery Before Promotion Start",
        "outcome": "block",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && change.order_units > 0) || deliveries[key].delivery_at < promotion.starts_at",
        "explain": "Ordered items must arrive before the promotion starts",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A6",
            "Rules!B6",
            "Rules!C6"
          ],
          "quote": "Anything we order must arrive before the promotion starts."
        }
      },
      {
        "id": "r6_max_discount",
        "statement": "R6",
        "sheet_rule": "R6",
        "kind": "product",
        "title": "Maximum Discount Limit",
        "outcome": "attention",
        "when": "key in offers",
        "assert": "!(key in offers) || (row.regular_price - change.offer_price) * 100 <= parameters[row.category].max_discount_pct * row.regular_price",
        "explain": "Discount must not exceed the category maximum discount percentage",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A7",
            "Rules!B7",
            "Rules!C7"
          ],
          "quote": "A discount deeper than the category maximum needs individual approval."
        }
      },
      {
        "id": "r7_ripe_cover",
        "statement": "R7",
        "sheet_rule": "R7",
        "kind": "product",
        "title": "Ripe Stock Cover Limit",
        "outcome": "attention",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && row.ripe == 'yes' && parameters[row.category].?ripe_cover_days.hasValue()) || double(stock[key].on_hand + stock[key].inbound_before_start - stock[key].reserved + change.order_units) <= double(parameters[row.category].?ripe_cover_days.orValue(0)) * facts.avg_sales",
        "explain": "Ripe stock plus order should not exceed ripe cover days of expected sales",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A8",
            "Rules!B8",
            "Rules!C8"
          ],
          "quote": "Ripe stock shouldn't cover more than the category's ripe cover days of expected sales."
        }
      },
      {
        "id": "r8_kit_scarcity",
        "statement": "R8",
        "sheet_rule": "R8",
        "kind": "kit",
        "title": "Kit Scarcity Limit",
        "outcome": "attention",
        "when": "false",
        "assert": "change.kit_limit <= rows.map(r, double(stock[r.component_sku].on_hand + stock[r.component_sku].inbound_before_start - stock[r.component_sku].reserved) / double(r.quantity)).filter(x, rows.map(r, double(stock[r.component_sku].on_hand + stock[r.component_sku].inbound_before_start - stock[r.component_sku].reserved) / double(r.quantity)).all(y, x <= y))[0]",
        "explain": "Kit limit cannot exceed what the scarcest component can supply",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A9",
            "Rules!B9",
            "Rules!C9"
          ],
          "quote": "Don't plan more kits than the scarcest component can supply."
        }
      },
      {
        "id": "r9_offer_below_regular",
        "statement": "R9",
        "sheet_rule": "R9",
        "kind": "product",
        "title": "Offer Price Below Regular Price",
        "outcome": "block",
        "when": "key in offers",
        "assert": "!(key in offers) || change.offer_price < row.regular_price",
        "explain": "Offer price must be strictly below regular price",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A10",
            "Rules!B10",
            "Rules!C10"
          ],
          "quote": "An offer or kit price must be below the regular price."
        }
      },
      {
        "id": "r9_kit_below_regular",
        "statement": "R9",
        "sheet_rule": "R9",
        "kind": "kit",
        "title": "Kit Price Below Regular Price",
        "outcome": "block",
        "when": "false",
        "assert": "change.kit_price < products[promotion.kit_id].regular_price",
        "explain": "Kit price must be below regular price",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A10",
            "Rules!B10",
            "Rules!C10"
          ],
          "quote": "An offer or kit price must be below the regular price."
        }
      },
      {
        "id": "r10_safety_stock",
        "statement": "R10",
        "sheet_rule": "R10",
        "kind": "product",
        "title": "Stock and Safety Coverage",
        "outcome": "attention",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && parameters[row.category].?safety_pct.hasValue()) || double(stock[key].on_hand + stock[key].inbound_before_start - stock[key].reserved + change.order_units) >= facts.avg_sales * (100.0 + double(parameters[row.category].?safety_pct.orValue(0))) / 100.0",
        "explain": "Stock plus order must cover expected demand plus safety stock percentage",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A11",
            "Rules!B11",
            "Rules!C11"
          ],
          "quote": "Stock plus the order should cover expected demand plus safety stock."
        }
      },
      {
        "id": "r11_max_order",
        "statement": "R11",
        "sheet_rule": "R11",
        "kind": "product",
        "title": "Supplier Maximum Order Limit",
        "outcome": "block",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && deliveries[key].?max_order_units.hasValue()) || change.order_units <= deliveries[key].?max_order_units.orValue(0)",
        "explain": "Order units must not exceed supplier maximum order units",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A12",
            "Rules!B12",
            "Rules!C12"
          ],
          "quote": "Don't order more than the supplier's maximum."
        }
      },
      {
        "id": "r12_cutoff",
        "statement": "R12",
        "sheet_rule": "R12",
        "kind": "product",
        "title": "Supplier Order Cut-off",
        "outcome": "block",
        "when": "key in deliveries",
        "assert": "!(key in deliveries && change.order_units > 0) || run_at < deliveries[key].cutoff_at",
        "explain": "Order must be placed before supplier cut-off time",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A13",
            "Rules!B13",
            "Rules!C13"
          ],
          "quote": "An order must be placed before its supplier's cut-off for the weekend it is for."
        }
      },
      {
        "id": "r13_price_cutoff_offer",
        "statement": "R13",
        "sheet_rule": "R13",
        "kind": "product",
        "title": "Price Cut-off for Offer Price",
        "outcome": "block",
        "when": "key in offers",
        "assert": "!(key in offers) || run_at < promotion.price_cutoff_at",
        "explain": "Offer price changes must be set before the price cut-off time",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A14",
            "Rules!B14",
            "Rules!C14"
          ],
          "quote": "Offer prices, the kit price and the kit limit must be set before the price cut-off."
        }
      },
      {
        "id": "r13_price_cutoff_kit_price",
        "statement": "R13",
        "sheet_rule": "R13",
        "kind": "kit",
        "title": "Price Cut-off for Kit Price",
        "outcome": "block",
        "when": "false",
        "assert": "run_at < promotion.price_cutoff_at",
        "explain": "Kit price changes must be set before the price cut-off time",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A14",
            "Rules!B14",
            "Rules!C14"
          ],
          "quote": "Offer prices, the kit price and the kit limit must be set before the price cut-off."
        }
      },
      {
        "id": "r13_price_cutoff_kit_limit",
        "statement": "R13",
        "sheet_rule": "R13",
        "kind": "kit",
        "title": "Price Cut-off for Kit Limit",
        "outcome": "block",
        "when": "false",
        "assert": "run_at < promotion.price_cutoff_at",
        "explain": "Kit limit changes must be set before the price cut-off time",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A14",
            "Rules!B14",
            "Rules!C14"
          ],
          "quote": "Offer prices, the kit price and the kit limit must be set before the price cut-off."
        }
      }
    ],
