    "timing": {
      "time_zone": "Europe/London",
      "period": "week",
      "week_starts_on": "Sat",
      "plan_ahead": 2,
      "current_until": {
        "table": "timing_policy",
        "time": "ends_at"
      },
      "times": [
        {
          "table": "timing_policy",
          "name": "scheduled_run_at",
          "day": "scheduled_run_day",
          "time": "scheduled_run_time",
          "role": "deadline",
          "meaning": "Scheduled run time"
        },
        {
          "table": "timing_policy",
          "name": "starts_at",
          "day": "starts_day",
          "time": "starts_time",
          "role": "deadline",
          "meaning": "Promotion start time"
        },
        {
          "table": "timing_policy",
          "name": "ends_at",
          "day": "ends_day",
          "time": "ends_time",
          "role": "deadline",
          "meaning": "Promotion end time"
        },
        {
          "table": "timing_policy",
          "name": "price_cutoff_at",
          "day": "price_cutoff_day",
          "time": "price_cutoff_time",
          "role": "deadline",
          "meaning": "Price cutoff time"
        },
        {
          "table": "stock",
          "name": "counted_at",
          "day": "counted_day",
          "time": "counted_time",
          "role": "observation",
          "meaning": "Stock count time"
        },
        {
          "table": "deliveries",
          "name": "delivered_at",
          "day": "delivery_day",
          "time": "delivery_time",
          "role": "deadline",
          "meaning": "Delivery time"
        },
        {
          "table": "deliveries",
          "name": "cutoff_at",
          "day": "cutoff_day",
          "time": "cutoff_time",
          "role": "deadline",
          "meaning": "Order cutoff time"
        }
      ],
      "source": {
        "cells": [
          "Promotion!B14"
        ],
        "quote": "The promotion runs every weekend, Saturday 07:00 to Sunday 22:00, UK time. Each run plans the coming weekend and the one after; a weekend counts as the coming one until its promotion ends. Stock counts and notes refer to their most recent occurrence before the run. Order cut-offs, deliveries and the price cut-off refer to the week of the weekend they are for."
      }
    },
    "items": [
      {
        "kind": "product",
        "label": "product",
        "table": "products",
        "key": "sku",
        "group": false
      },
      {
        "kind": "kit",
        "label": "kit",
        "table": "kit",
        "key": "kit_id",
        "group": true
      }
    ],
    "editable": [
      {
        "kind": "product",
        "name": "offer_price",
        "label": "offer_price",
        "type": "money",
        "applies_when": "key in offers && offers[key].?brief_offer_price.hasValue()",
        "default": "offers[key].?brief_offer_price.orValue(0)",
        "source": {
          "cells": [
            "Changes!A3",
            "Changes!B3",
            "Changes!C3",
            "Changes!D3",
            "Changes!E3"
          ],
          "quote": "offer_price\teach product with an offer\tmoney\tthe offer price in the brief\tThe promotional shelf price."
        }
      },
      {
        "kind": "product",
        "name": "order_units",
        "label": "order_units",
        "type": "whole_number",
        "applies_when": "\"\" != key",
        "default": "0",
        "source": {
          "cells": [
            "Changes!A2",
            "Changes!B2",
            "Changes!C2",
            "Changes!D2",
            "Changes!E2"
          ],
          "quote": "order_units\teach product\twhole number of units\t0\tUnits to order as a final top-up for the weekend."
        }
      },
      {
        "kind": "kit",
        "name": "kit_price",
        "label": "kit_price",
        "type": "money",
        "applies_when": "\"\" != key",
        "default": "0",
        "source": {
          "cells": [
            "Changes!A4",
            "Changes!B4",
            "Changes!C4",
            "Changes!D4",
            "Changes!E4"
          ],
          "quote": "kit_price\tthe kit\tmoney\tthe kit price in the brief\tThe price of the Avo toast kit."
        }
      },
      {
        "kind": "kit",
        "name": "kit_limit",
        "label": "kit_limit",
        "type": "whole_number",
        "applies_when": "\"\" != key",
        "default": "0",
        "source": {
          "cells": [
            "Changes!A5",
            "Changes!B5",
            "Changes!C5",
            "Changes!D5",
            "Changes!E5"
          ],
          "quote": "kit_limit\tthe kit\twhole number of kits\tthe number of kits expected to sell\tHow many kits to put out over the weekend."
        }
      }
    ],
    "facts": [
      {
        "kind": "product",
        "name": "margin_floor_pct",
        "label": "margin_floor_pct",
        "type": "int",
        "expr": "parameters[row.category].margin_floor_pct",
        "explain": "Category margin floor percentage"
      },
      {
        "kind": "product",
        "name": "max_discount_pct",
        "label": "max_discount_pct",
        "type": "int",
        "expr": "parameters[row.category].?max_discount_pct.orValue(0)",
        "explain": "Category maximum discount percentage"
      },
      {
        "kind": "product",
        "name": "max_count_age_hours",
        "label": "max_count_age_hours",
        "type": "int",
        "expr": "parameters[row.category].?max_count_age_hours.orValue(0)",
        "explain": "Category maximum count age in hours"
      },
      {
        "kind": "product",
        "name": "safety_pct",
        "label": "safety_pct",
        "type": "int",
        "expr": "parameters[row.category].?safety_pct.orValue(0)",
        "explain": "Category safety stock percentage"
      },
      {
        "kind": "product",
        "name": "ripe_cover_days",
        "label": "ripe_cover_days",
        "type": "int",
        "expr": "parameters[row.category].?ripe_cover_days.orValue(0)",
        "explain": "Category ripe cover days"
      },
      {
        "kind": "product",
        "name": "expected_sales",
        "label": "expected_sales",
        "type": "int",
        "expr": "sales[key].weekend_1 * (100 + offers[key].uplift_pct) / 100 + sales[key].weekend_2 * (100 + offers[key].uplift_pct) / 100 + sales[key].weekend_3 * (100 + offers[key].uplift_pct) / 100 + sales[key].weekend_4 * (100 + offers[key].uplift_pct) / 100",
        "explain": "Total expected sales across all weekends with uplift"
      },
      {
        "kind": "kit",
        "name": "kit_component_cost",
        "label": "kit_component_cost",
        "type": "int",
        "expr": "rows.map(r, products[r.component_sku].cost_price * r.quantity).sum()",
        "explain": "Sum of kit component costs"
      },
      {
        "kind": "kit",
        "name": "max_kit_supply",
        "label": "max_kit_supply",
        "type": "int",
        "expr": "rows.map(r, (stock[r.component_sku].on_hand - stock[r.component_sku].reserved + stock[r.component_sku].inbound_before_start) / r.quantity).filter(x, rows.all(y, (stock[y.component_sku].on_hand - stock[y.component_sku].reserved + stock[y.component_sku].inbound_before_start) / y.quantity >= x))[0]",
        "explain": "Maximum number of kits possible from stock components"
      }
    ],
    "rules": [
      {
        "id": "r1",
        "statement": "R1",
        "sheet_rule": "R1",
        "kind": "product",
        "title": "Offer price margin floor",
        "outcome": "block",
        "when": "key in offers && has(change.offer_price)",
        "assert": "!has(change.offer_price) || (change.offer_price - row.cost_price) * 100 >= facts.margin_floor_pct * change.offer_price",
        "explain": "An offer price must keep at least the category's margin floor.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A2",
            "Rules!B2",
            "Rules!C2"
          ],
          "quote": "An offer price must keep at least the category's margin floor."
        }
      },
      {
        "id": "r2",
        "statement": "R2",
        "sheet_rule": "R2",
        "kind": "kit",
        "title": "Kit price margin floor",
        "outcome": "block",
        "when": "has(change.kit_price)",
        "assert": "(change.kit_price - facts.kit_component_cost) * 100 >= parameters['kit'].margin_floor_pct * change.kit_price",
        "explain": "The kit price must keep at least the kit margin floor, counting the cost of every component.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A3",
            "Rules!B3",
            "Rules!C3"
          ],
          "quote": "The kit price must keep at least the kit margin floor, counting the cost of every component."
        }
      },
      {
        "id": "r3",
        "statement": "R3",
        "sheet_rule": "R3",
        "kind": "product",
        "title": "Whole cases order quantities",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "row.case_size == 0 || change.order_units % row.case_size == 0",
        "explain": "Order quantities must be whole cases.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A4",
            "Rules!B4",
            "Rules!C4"
          ],
          "quote": "Order quantities must be whole cases."
        }
      },
      {
        "id": "r4",
        "statement": "R4",
        "sheet_rule": "R4",
        "kind": "product",
        "title": "Stock count age limit",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "change.order_units == 0 || !parameters[row.category].?max_count_age_hours.hasValue() || (stock[key].counted_at - run_at).getHours() <= facts.max_count_age_hours",
        "explain": "Don't use a stock count older than the category's limit; recount first.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A5",
            "Rules!B5",
            "Rules!C5"
          ],
          "quote": "Don't use a stock count older than the category's limit; recount first."
        }
      },
      {
        "id": "r5",
        "statement": "R5",
        "sheet_rule": "R5",
        "kind": "product",
        "title": "Delivery before promotion starts",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "change.order_units == 0 || !deliveries[key].?delivered_at.hasValue() || deliveries[key].delivered_at < timing_policy.starts_at",
        "explain": "Anything we order must arrive before the promotion starts.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A6",
            "Rules!B6",
            "Rules!C6"
          ],
          "quote": "Anything we order must arrive before the promotion starts."
        }
      },
      {
        "id": "r6",
        "statement": "R6",
        "sheet_rule": "R6",
        "kind": "product",
        "title": "Maximum discount percentage",
        "outcome": "attention",
        "when": "key in offers && has(change.offer_price)",
        "assert": "!has(change.offer_price) || !parameters[row.category].?max_discount_pct.hasValue() || (row.regular_price - change.offer_price) * 100 <= facts.max_discount_pct * row.regular_price",
        "explain": "A discount deeper than the category maximum needs individual approval.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A7",
            "Rules!B7",
            "Rules!C7"
          ],
          "quote": "A discount deeper than the category maximum needs individual approval."
        }
      },
      {
        "id": "r7",
        "statement": "R7",
        "sheet_rule": "R7",
        "kind": "product",
        "title": "Ripe stock cover days",
        "outcome": "attention",
        "when": "has(change.order_units)",
        "assert": "row.ripe != 'yes' || !parameters[row.category].?ripe_cover_days.hasValue() || (stock[key].on_hand - stock[key].reserved + stock[key].inbound_before_start + change.order_units) * 7 <= facts.ripe_cover_days * facts.expected_sales",
        "explain": "Ripe stock shouldn't cover more than the category's ripe cover days of expected sales.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A8",
            "Rules!B8",
            "Rules!C8"
          ],
          "quote": "Ripe stock shouldn't cover more than the category's ripe cover days of expected sales."
        }
      },
      {
        "id": "r8",
        "statement": "R8",
        "sheet_rule": "R8",
        "kind": "kit",
        "title": "Kit component supply limit",
        "outcome": "attention",
        "when": "has(change.kit_limit)",
        "assert": "!has(change.kit_limit) || change.kit_limit <= facts.max_kit_supply",
        "explain": "Don't plan more kits than the scarcest component can supply.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A9",
            "Rules!B9",
            "Rules!C9"
          ],
          "quote": "Don't plan more kits than the scarcest component can supply."
        }
      },
      {
        "id": "r9",
        "statement": "R9",
        "sheet_rule": "R9",
        "kind": "kit",
        "title": "Price below regular price",
        "outcome": "block",
        "when": "has(change.kit_price)",
        "assert": "!has(change.kit_price) || change.kit_price < products['AV-LS'].regular_price",
        "explain": "An offer or kit price must be below the regular price.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A10",
            "Rules!B10",
            "Rules!C10"
          ],
          "quote": "An offer or kit price must be below the regular price."
        }
      },
      {
        "id": "r10",
        "statement": "R10",
        "sheet_rule": "R10",
        "kind": "product",
        "title": "Stock and order cover demand plus safety",
        "outcome": "attention",
        "when": "has(change.order_units)",
        "assert": "(stock[key].on_hand - stock[key].reserved + stock[key].inbound_before_start + change.order_units) * 100 >= facts.expected_sales * (100 + facts.safety_pct)",
        "explain": "Stock plus the order should cover expected demand plus safety stock.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A11",
            "Rules!B11",
            "Rules!C11"
          ],
          "quote": "Stock plus the order should cover expected demand plus safety stock."
        }
      },
      {
        "id": "r11",
        "statement": "R11",
        "sheet_rule": "R11",
        "kind": "product",
        "title": "Supplier maximum order units",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "!deliveries[key].?max_order_units.hasValue() || change.order_units <= deliveries[key].max_order_units",
        "explain": "Don't order more than the supplier's maximum.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A12",
            "Rules!B12",
            "Rules!C12"
          ],
          "quote": "Don't order more than the supplier's maximum."
        }
      },
      {
        "id": "r12",
        "statement": "R12",
        "sheet_rule": "R12",
        "kind": "product",
        "title": "Supplier cutoff time",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "change.order_units == 0 || !deliveries[key].?cutoff_at.hasValue() || timing_policy.scheduled_run_at <= deliveries[key].cutoff_at",
        "explain": "An offer or kit price must be below the regular price.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A13",
            "Rules!B13",
            "Rules!C13"
          ],
          "quote": "An order must be placed before its supplier's cut-off for the weekend it is for."
        }
      },
      {
        "id": "r13",
        "statement": "R13",
        "sheet_rule": "R13",
        "kind": "product",
        "title": "Price cutoff time",
        "outcome": "block",
        "when": "has(change.offer_price) || has(change.kit_price) || has(change.kit_limit)",
        "assert": "(!has(change.offer_price) && !has(change.kit_price) && !has(change.kit_limit)) || timing_policy.scheduled_run_at <= timing_policy.price_cutoff_at",
        "explain": "Offer prices, the kit price and the kit limit must be set before the price cut-off.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!A14",
            "Rules!B14",
            "Rules!C14"
          ],
          "quote": "Offer prices, the kit price and the kit limit must be set before the price cut-off."
        }
      }
    ],
    "not_ruled": [],
    "data_model_requests": [],
    "notes": [
      "All rules and editable variables defined correctly with proper kind assignments."
    ]
  }
