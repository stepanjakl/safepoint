          "time": "price_cutoff_time",
          "role": "deadline",
          "meaning": "Price cutoff"
        },
        {
          "table": "promotion",
          "name": "scheduled_run_at",
          "day": "scheduled_run_day",
          "time": "scheduled_run_time",
          "role": "deadline",
          "meaning": "Scheduled run"
        },
        {
          "table": "stock",
          "name": "counted_at",
          "day": "counted_day",
          "time": "counted_time",
          "role": "observation",
          "meaning": "Stock count time"
        },
        {
          "table": "deliveries",
          "name": "delivered_at",
          "day": "delivery_day",
          "time": "delivery_time",
          "role": "deadline",
          "meaning": "Delivery time"
        },
        {
          "table": "deliveries",
          "name": "cutoff_at",
          "day": "cutoff_day",
          "time": "cutoff_time",
          "role": "deadline",
          "meaning": "Order cutoff time"
        }
      ],
      "source": {
        "cells": [
          "Promotion!B15"
        ],
        "quote": "The promotion runs every weekend, Saturday 07:00 to Sunday 22:00, UK time. Each run plans the coming weekend and the one after; a weekend counts as the coming one until its promotion ends. Stock counts and notes refer to their most recent occurrence before the run. Order cut-offs, deliveries and the price cut-off refer to the week of the weekend they are for."
      }
    },
    "items": [
      {
        "kind": "product",
        "label": "Product",
        "table": "products",
        "key": "sku",
        "group": false
      },
      {
        "kind": "kit",
        "label": "Kit",
        "table": "kit",
        "key": "component_sku",
        "group": false
      }
    ],
    "editable": [
      {
        "kind": "product",
        "name": "offer_price",
        "label": "The promotional shelf price",
        "type": "money",
        "applies_when": "key in offers && offers[key].?brief_offer_price.hasValue()",
        "default": "offers[key].brief_offer_price",
        "source": {
          "cells": [
            "Changes!E3"
          ],
          "quote": "The promotional shelf price."
        }
      },
      {
        "kind": "product",
        "name": "order_units",
        "label": "Units to order as a final top-up for the weekend",
        "type": "whole_number",
        "applies_when": "key in deliveries",
        "default": "0",
        "source": {
          "cells": [
            "Changes!E2"
          ],
          "quote": "Units to order as a final top-up for the weekend."
        }
      },
      {
        "kind": "kit",
        "name": "kit_price",
        "label": "The price of the Avo toast kit",
        "type": "money",
        "applies_when": "key == 'KIT-01'",
        "default": "promotion.kit_brief_price",
        "source": {
          "cells": [
            "Changes!E4"
          ],
          "quote": "The price of the Avo toast kit."
        }
      },
      {
        "kind": "kit",
        "name": "kit_limit",
        "label": "How many kits to put out over the weekend",
        "type": "whole_number",
        "applies_when": "key == 'KIT-01'",
        "default": "promotion.expected_kits",
        "source": {
          "cells": [
            "Changes!E5"
          ],
          "quote": "How many kits to put out over the weekend."
        }
      }
    ],
    "facts": [
      {
        "kind": "product",
        "name": "avg_sales",
        "label": "Average Sales",
        "type": "int",
        "expr": "(sales[key].weekend_1 + sales[key].weekend_2 + sales[key].weekend_3 + sales[key].weekend_4) / 4",
        "explain": "Average of the last four weekends' sales",
        "statement": "D1"
      },
      {
        "kind": "product",
        "name": "kit_component_demand",
        "label": "Kit Component Demand",
        "type": "int",
        "expr": "kit.map(k_key, kit[k_key].component_sku == key ? kit[k_key].quantity * promotion.expected_kits : 0).sum()",
        "explain": "Sum of component quantities in kits for this product SKU",
        "statement": "D1"
      },
      {
        "kind": "product",
        "name": "expected_demand",
        "label": "Expected Demand",
        "type": "int",
        "expr": "(facts.avg_sales * (100 + offers[key].uplift_pct)) / 100 + facts.kit_component_demand",
        "explain": "Expected demand for a weekend raised by uplift_pct and including kit component demand",
        "statement": "D1"
      }
    ],
    "rules": [
      {
        "id": "r1",
        "statement": "R1",
        "sheet_rule": "R1",
        "kind": "product",
        "title": "Offer margin floor",
        "outcome": "block",
        "when": "key in offers && has(change.offer_price)",
        "assert": "!((key in offers) && has(change.offer_price)) || ((change.offer_price - row.cost_price) * 100 >= parameters[row.category].margin_floor_pct * change.offer_price)",
        "explain": "An offer price must keep at least the category's margin floor.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B2"
          ],
          "quote": "An offer price must keep at least the category's margin floor."
        }
      },
      {
        "id": "r2",
        "statement": "R2",
        "sheet_rule": "R2",
        "kind": "kit",
        "title": "Kit margin floor",
        "outcome": "block",
        "when": "key == 'KIT-01' && has(change.kit_price)",
        "assert": "!((key == 'KIT-01') && has(change.kit_price)) || kit.all(k_key, (change.kit_price - products[kit[k_key].component_sku].cost_price * kit[k_key].quantity) * 100 >= parameters['kit'].margin_floor_pct * change.kit_price)",
        "explain": "The kit price must keep at least the kit margin floor, counting the cost of every component.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B3"
          ],
          "quote": "The kit price must keep at least the kit margin floor, counting the cost of every component."
        }
      },
      {
        "id": "r3",
        "statement": "R3",
        "sheet_rule": "R3",
        "kind": "product",
        "title": "Whole case orders",
        "outcome": "block",
        "when": "has(change.order_units)",
        "assert": "!has(change.order_units) || (row.case_size == 0 ? change.order_units == 0 : change.order_units % row.case_size == 0)",
        "explain": "Order quantities must be whole cases.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B4"
          ],
          "quote": "Order quantities must be whole cases."
        }
      },
      {
        "id": "r4",
        "statement": "R4",
        "sheet_rule": "R4",
        "kind": "product",
        "title": "Stock count age limit",
        "outcome": "block",
        "when": "key in stock",
        "assert": "!parameters[row.category].?max_count_age_hours.hasValue() || (run_at - stock[key].counted_at).getHours() <= parameters[row.category].max_count_age_hours",
        "explain": "Don't use a stock count older than the category's limit; recount first.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B5"
          ],
          "quote": "Don't use a stock count older than the category's limit; recount first."
        }
      },
      {
        "id": "r5",
        "statement": "R5",
        "sheet_rule": "R5",
        "kind": "product",
        "title": "Delivery before promotion starts",
        "outcome": "block",
        "when": "has(change.order_units) && key in deliveries",
        "assert": "!has(change.order_units) || change.order_units == 0 || !deliveries[key].?delivered_at.hasValue() || deliveries[key].delivered_at < promotion.starts_at",
        "explain": "Anything we order must arrive before the promotion starts.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B6"
          ],
          "quote": "Anything we order must arrive before the promotion starts."
        }
      },
      {
        "id": "r7",
        "statement": "R7",
        "sheet_rule": "R7",
        "kind": "product",
        "title": "Ripe stock cover limit",
        "outcome": "attention",
        "when": "row.ripe && key in stock && key in offers",
        "assert": "!row.ripe || !parameters[row.category].?ripe_cover_days.hasValue() || (stock[key].on_hand + stock[key].inbound_before_start - stock[key].reserved <= (parameters[row.category].ripe_cover_days * facts.expected_demand) / 2)",
        "explain": "Ripe stock shouldn't cover more than the category's ripe cover days of expected sales.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B8"
          ],
          "quote": "Ripe stock shouldn't cover more than the category's ripe cover days of expected sales."
        }
      },
      {
        "id": "r8",
        "statement": "R8",
        "sheet_rule": "R8",
        "kind": "kit",
        "title": "Kit component supply limit",
        "outcome": "attention",
        "when": "key == 'KIT-01' && has(change.kit_limit)",
        "assert": "!(key == 'KIT-01' && has(change.kit_limit)) || kit.all(k_key, change.kit_limit * kit[k_key].quantity <= stock[kit[k_key].component_sku].on_hand + stock[kit[k_key].component_sku].inbound_before_start - stock[kit[k_key].component_sku].reserved)",
        "explain": "Don't plan more kits than the scarcest component can supply.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B9"
          ],
          "quote": "Don't plan more kits than the scarcest component can supply."
        }
      },
      {
        "id": "r9",
        "statement": "R9",
        "sheet_rule": "R9",
        "kind": "product",
        "title": "Offer price below regular price",
        "outcome": "block",
        "when": "key in offers && has(change.offer_price)",
        "assert": "!((key in offers) && has(change.offer_price)) || change.offer_price < row.regular_price",
        "explain": "An offer price must be below the regular price.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B10"
          ],
          "quote": "An offer or kit price must be below the regular price."
        }
      },
      {
        "id": "r10",
        "statement": "R10",
        "sheet_rule": "R11",
        "kind": "product",
        "title": "Stock plus order cover",
        "outcome": "attention",
        "when": "key in stock && key in offers && has(change.order_units)",
        "assert": "!parameters[row.category].?safety_pct.hasValue() || !has(change.order_units) || (stock[key].on_hand + stock[key].inbound_before_start - stock[key].reserved + change.order_units >= (facts.expected_demand * (100 + parameters[row.category].safety_pct)) / 100)",
        "explain": "Stock plus the order should cover expected demand plus safety stock.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B11"
          ],
          "quote": "Stock plus the order should cover expected demand plus safety stock."
        }
      },
      {
        "id": "r11",
        "statement": "R11",
        "sheet_rule": "R12",
        "kind": "product",
        "title": "Maximum order units limit",
        "outcome": "block",
        "when": "has(change.order_units) && key in deliveries",
        "assert": "!has(change.order_units) || !deliveries[key].?max_order_units.hasValue() || change.order_units <= deliveries[key].max_order_units",
        "explain": "Don't order more than the supplier's maximum.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B12"
          ],
          "quote": "Don't order more than the supplier's maximum."
        }
      },
      {
        "id": "r12",
        "statement": "R12",
        "sheet_rule": "R13",
        "kind": "product",
        "title": "Supplier order cutoff",
        "outcome": "block",
        "when": "has(change.order_units) && key in deliveries",
        "assert": "!has(change.order_units) || change.order_units == 0 || !deliveries[key].?cutoff_at.hasValue() || run_at < deliveries[key].cutoff_at",
        "explain": "An order must be placed before its supplier's cut-off for the weekend it is for.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B13"
          ],
          "quote": "An order must be placed before its supplier's cut-off for the weekend it is for."
        }
      },
      {
        "id": "r13",
        "statement": "R13",
        "sheet_rule": "R14",
        "kind": "product",
        "title": "Offer price cut-off",
        "outcome": "block",
        "when": "key in offers && has(change.offer_price)",
        "assert": "(!((key in offers) && has(change.offer_price)) || run_at < promotion.price_cutoff_at)",
        "explain": "Offer prices must be set before the price cut-off.",
        "origin": "sheet",
        "source": {
          "cells": [
            "Rules!B14"
          ],
          "quote": "Offer prices, the kit price and the kit limit must be set before the price cut-off."
        }
      }
    ],
    "not_ruled": [
      {
        "statement": "R6",
        "reason": "Individual approval cannot be checked by formula as stated in the inventory."
      }
    ],
    "data_model_requests": [],
    "notes": [
      "All inventory items and rules have been fully addressed."
    ]
  }
}
