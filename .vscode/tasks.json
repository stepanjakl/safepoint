{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server with colour diagnostics",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "safepoint-colours",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (warning): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[colours\\] Checking offsets$",
          "endsPattern": "^\\[colours\\] Check finished$"
        }
      }
    }
  ]
}
