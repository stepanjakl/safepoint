{
  "files.exclude": {
    "**/.next": true
  },
  "search.exclude": {
    "**/.next": true
  },
  "cssVariables.blacklistFolders": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/node_modules",
    "**/bower_components",
    "**/tmp",
    "**/dist",
    "**/tests",
    "**/.next/**"
  ],
  "cssVariables.languages": [
    "astro",
    "svelte",
    "vue",
    "vue-html",
    "vue-postcss",
    "scss",
    "postcss",
    "less",
    "css",
    "html",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "source.css.styled",
    "tailwindcss"
  ],
  // Every Tailwind utility would read as an unused class.
  "unusedCssClasses.enable": false,
  "tailwindCSS.classFunctions": ["cx"],
  // Class lists kept in upper-case constants (`const ITEM = '…'`, `FACE = {…}`)
  // get the same hover and completion as a className.
  "tailwindCSS.experimental.classRegex": [
    [
      "(?:const|let)\\s+[A-Z][A-Z0-9_]*\\s*=\\s*([\\s\\S]*?);",
      "['\"`]([^'\"`]*)['\"`]"
    ]
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": "app/styles/index.css",
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
