# The rules engine's model calls. Use a Google AI Studio key; keep the real key in .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Requests a minute per model group; otherwise learned from refusals.
# GEMINI_REQUESTS_PER_MINUTE=

# Development-only Google Sheet reads for the Brunch examples. Server-only.
# COMPOSIO_API_KEY is a developer project key (ak_...), not a consumer key (ck_...).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional. The database (docs/engineering/DATABASE.md). Unset, the app keeps a
# local PGlite database in data/pglite/ and needs no credentials. Set, it is the
# Neon dev branch's pooled URL (host ending -pooler); migrations take the direct one.
# On Vercel both are required (README -> Deploying to Vercel): with no URL the app
# refuses to start a database there, and a production build migrates over the direct one.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Required outside local development: the shared password and the key the
# cookie is signed with (docs/engineering/ARCHITECTURE.md -> Trust and state).
# Unset or too short (16 and 32 characters), every request is refused. Generate
# each with `openssl rand -base64 32`; never reuse one for the other. Changing
# the secret signs everyone out. Local development needs neither.
# SAFEPOINT_ACCESS_KEY=
# SAFEPOINT_COOKIE_SECRET=
# Set to 1 to apply the gate in local development too, to try it.
# SAFEPOINT_GATE=

# Marks a server database as development, so `pnpm db:reset` may drop it: the
# exact URL the reset would use (DATABASE_URL_UNPOOLED where set). Never production's.
# SAFEPOINT_RESETTABLE_DATABASE_URL=
