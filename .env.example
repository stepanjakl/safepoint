# Development-only model workbench at /workbench/model.
# Use a Google AI Studio key for the synthetic scenario. Keep the real key in .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=

# Sheet process (docs/SHEET-PROCESS-PLAN.md, Appendix B). Server-only.
# COMPOSIO_API_KEY is a developer project key (ak_...), not a consumer key (ck_...).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
