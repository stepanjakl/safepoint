# Development-only model workbench at /workbench/model.
# Use a Google AI Studio key for the synthetic scenario. Keep the real key in .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Requests a minute per model group; otherwise learned from refusals.
# GEMINI_REQUESTS_PER_MINUTE=

# Development-only Google Sheet reads for the Brunch examples. Server-only.
# COMPOSIO_API_KEY is a developer project key (ak_...), not a consumer key (ck_...).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
