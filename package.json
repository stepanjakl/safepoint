{
  "name": "safepoint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node scripts/runtime/dev.ts",
    "agentation:wait": "node scripts/runtime/agentation-wait.ts",
    "build": "next build",
    "vercel-build": "node scripts/runtime/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:postgres": "vitest run --testTimeout 300000 server/db/postgres.test.ts server/db/postgres-schema.test.ts",
    "check:sidebars": "playwright test e2e/shell/sidebars.spec.ts --project=light",
    "check:rail": "node scripts/checks/check-rail-alignment.ts",
    "check:contrast": "playwright test",
    "check:visual": "playwright test e2e/design/visual.spec.ts",
    "check:visual:update": "UPDATE_VISUAL=1 playwright test e2e/design/visual.spec.ts",
    "check:contrast:report": "playwright show-report",
    "check:colour-system": "playwright test e2e/design/colour-system.spec.ts",
    "check:colours": "node scripts/colours/colour-theme/generate.ts --check",
    "check:perception": "playwright test e2e/design/colour-perception.spec.ts e2e/design/colour-vision.spec.ts --project=light",
    "check:perception:report": "COLOUR_PERCEPTION_REPORT=test-results/colour-perception.json COLOUR_VISION_REPORT=test-results/colour-vision.json playwright test e2e/design/colour-perception.spec.ts e2e/design/colour-vision.spec.ts --project=light && node scripts/colours/colour-theme/perceptual/report.ts test-results/colour-perception.json test-results/colour-vision.json docs/generated/colour-perception-report.json",
    "check:tokens": "node scripts/colours/check-token-refs.mjs",
    "check:unused": "knip",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server scripts/db/db.ts migrate",
    "db:reset": "node --env-file-if-exists=.env.local --conditions=react-server scripts/db/db.ts reset",
    "db:import": "node --env-file-if-exists=.env.local --conditions=react-server --import ./scripts/runtime/resolve-aliases.mjs scripts/db/import-kept-data.ts",
    "db:studio": "pnpm db:migrate && node --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs studio",
    "rulebooks:export": "node --env-file-if-exists=.env.local --conditions=react-server --import ./scripts/runtime/resolve-aliases.mjs scripts/db/export-rulebooks.ts",
    "fixtures:e2e": "UPDATE_E2E_FIXTURES=1 vitest run lib/engine/e2e-fixtures.test.ts",
    "trace:token": "node scripts/colours/trace-token.mjs",
    "colors:custom": "node scripts/colours/colour-theme/generate.ts",
    "colors:radix": "node scripts/colours/generate-radix-colors.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.109",
    "@composio/core": "0.27.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@marcbachmann/cel-js": "8.0.0",
    "@outpacelabs/avatars": "^0.6.0",
    "@tanstack/react-query": "5.107.1",
    "@trpc/client": "11.28.0",
    "@trpc/server": "11.28.0",
    "@trpc/tanstack-react-query": "11.28.0",
    "@vercel/functions": "3.11.3",
    "ai": "7.0.159",
    "blode-icons-react": "^1.0.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.0",
    "motion": "^14.9.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "torph": "^0.1.3",
    "workflow": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "1.0.62",
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "^1.64.1",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tweakpane/core": "2.0.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "agentation": "^3.1.2",
    "agentation-mcp": "1.3.2",
    "colorjs.io": "0.7.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "knip": "6.44.0",
    "postcss": "8.5.32",
    "postcss-light-dark": "link:tools/postcss-light-dark",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tweakpane": "^4.0.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  }
}
