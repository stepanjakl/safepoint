{
  "name": "safepoint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:sidebars": "playwright test e2e/sidebars.spec.ts --project=light",
    "check:rail": "node scripts/check-rail-alignment.ts",
    "check:contrast": "playwright test",
    "check:visual": "playwright test e2e/visual.spec.ts",
    "check:visual:update": "UPDATE_VISUAL=1 playwright test e2e/visual.spec.ts",
    "check:contrast:report": "playwright show-report",
    "check:colour-system": "playwright test e2e/colour-system.spec.ts",
    "check:colours": "node scripts/colour-theme/generate.ts --check",
    "check:tokens": "node scripts/check-token-refs.mjs",
    "check:unused": "knip",
    "trace:token": "node scripts/trace-token.mjs",
    "colors:custom": "node scripts/colour-theme/generate.ts",
    "colors:radix": "node scripts/generate-radix-colors.ts"
  },
  "dependencies": {
    "@outpacelabs/avatars": "^0.6.0",
    "blode-icons-react": "^1.0.0",
    "geist": "1.7.2",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.8",
    "torph": "^0.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/preset-typescript": "^7.29.7",
    "@locator/runtime": "^0.5.1",
    "@locator/webpack-loader": "^0.5.1",
    "@playwright/test": "^1.63.0",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tweakpane/core": "2.0.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "colorjs.io": "0.7.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "knip": "6.38.0",
    "postcss": "8.5.26",
    "postcss-light-dark": "link:./tools/postcss-light-dark",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tweakpane": "^4.0.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
