  "sentences": {
    "arrive_before_opening": {
      "own": "The proposed order is allowed only when the delivery is before the start (Sat 07:00). Proposing 0 units is always allowed.",
      "versions": [
        "The proposed order is allowed only when the delivery is before the start (Sat 07:00). Proposing 0 units is always allowed.",
        "The proposed order is allowed only when the delivery is before the start (Sat 07:00). Proposing 0 units is always allowed.",
      ],
    },
    "before_supplier_cutoff": {
      "own": "The proposed order is allowed only when the data is read before the supplier’s cutoff. Proposing 0 units is always allowed.",
      "versions": [
        "The proposed order is allowed only when the data is read before the supplier’s cutoff. Proposing 0 units is always allowed.",
        "The proposed order is allowed only when the data is read before the supplier’s cutoff. Proposing 0 units is always allowed.",
      ],
    },
    "cover_expected_sales_and_margin": {
      "own": "The stock available plus the proposed order should reach the expected sales plus the category safety pct percent. Otherwise a person decides.",
      "versions": [
        "The stock available plus the proposed order should reach the expected sales plus the category safety pct percent. Otherwise a person decides.",
        "The stock available plus the proposed order should reach the expected sales plus the category safety pct percent. Otherwise a person decides.",
      ],
    },
    "expected_sales": {
      "own": null,
      "versions": [
        null,
        null,
      ],
    },
    "max_supplier_delivery": {
      "own": "The proposed order must be at most the max order units. Proposing 0 units is always allowed. Where the max order units is blank, it fails.",
      "versions": [
        "The proposed order must be at most the max order units. Proposing 0 units is always allowed. Where the max order units is blank, it fails.",
        "The proposed order must be at most the max order units. Proposing 0 units is always allowed. Where the max order units is blank, it does not apply.",
      ],
    },
    "order_in_whole_cases": {
      "own": "The proposed order must be a whole multiple of the case size. Proposing 0 units is always allowed.",
      "versions": [
        "The proposed order must be a whole multiple of the case size. Proposing 0 units is always allowed.",
        "The proposed order must be a whole multiple of the case size. Proposing 0 units is always allowed.",
      ],
    },
    "ripe_avocado_limit": {
      "own": "For products in “ripe avocados” only: the stock available plus the proposed order must not exceed the expected sales. Proposing 0 units is always allowed.",
      "versions": [
        "For products in “ripe avocados” only: the stock available plus the proposed order must not exceed the expected sales. Proposing 0 units is always allowed.",
        "For products in “ripe avocados” only: the on hand plus the proposed order must not exceed the expected sales. Proposing 0 units is always allowed.",
      ],
    },
    "stock_available": {
      "own": null,
      "versions": [
        null,
        null,
      ],
    },
    "stock_count_age_check": {
      "own": "Flag it for a person when the hours from the stock count to when the data is read is more than the category max count age hours.",
      "versions": [
        "Flag it for a person when the hours from the stock count to when the data is read is more than the category max count age hours.",
        "Flag it for a person when the hours from the stock count to when the data is read is more than the category max count age hours.",
      ],
