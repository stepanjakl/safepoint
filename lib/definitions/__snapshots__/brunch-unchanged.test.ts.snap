  "written": {
    "arrive_before_opening own": "!((has(record.moment__delivery)) && (has(record.moment__start))) || order == 0 || (record.moment__delivery < record.moment__start)",
    "arrive_before_opening version 1": "!((has(record.moment__delivery)) && (has(record.moment__start))) || order == 0 || (record.moment__delivery < record.moment__start)",
    "arrive_before_opening version 2": "order == 0 || ((has(record.moment__delivery)) && (has(record.moment__start)) && (record.moment__delivery < record.moment__start))",
    "before_supplier_cutoff own": "!(has(record.moment__cutoff)) || order == 0 || (0.0 < record.moment__cutoff)",
    "before_supplier_cutoff version 1": "!(has(record.moment__cutoff)) || order == 0 || (0.0 < record.moment__cutoff)",
    "before_supplier_cutoff version 2": "!(has(record.moment__cutoff)) || order == 0 || (0.0 < record.moment__cutoff)",
    "cover_expected_sales_and_margin own": "!(has(category.safety_pct)) || (double(values.stock_available) + double(order) >= double(values.expected_sales) * (1.0 + double(category.safety_pct) / 100.0))",
    "cover_expected_sales_and_margin version 1": "!(has(category.safety_pct)) || (double(values.stock_available) + double(order) >= double(values.expected_sales) * (1.0 + double(category.safety_pct) / 100.0))",
    "cover_expected_sales_and_margin version 2": "!(has(category.safety_pct)) || (double(values.stock_available) + double(order) >= double(values.expected_sales) * (1.0 + double(category.safety_pct) / 100.0))",
    "max_supplier_delivery own": "order == 0 || (has(record.max_order_units) && (double(order) <= double(record.max_order_units)))",
    "max_supplier_delivery version 1": "order == 0 || (has(record.max_order_units) && (double(order) <= double(record.max_order_units)))",
    "max_supplier_delivery version 2": "!(has(record.max_order_units)) || order == 0 || (double(order) <= double(record.max_order_units))",
    "order_in_whole_cases own": "order == 0 || (has(record.case_size) && (order % int(double(record.case_size)) == 0))",
    "order_in_whole_cases version 1": "order == 0 || (has(record.case_size) && (order % int(double(record.case_size)) == 0))",
    "order_in_whole_cases version 2": "!(has(record.case_size)) || order == 0 || (order % int(double(record.case_size)) == 0)",
    "ripe_avocado_limit own": "!(key in groups.ripe_avocados) || order == 0 || (double(values.stock_available) + double(order) <= double(values.expected_sales))",
    "ripe_avocado_limit version 1": "!(key in groups.ripe_avocados) || order == 0 || (double(values.stock_available) + double(order) <= double(values.expected_sales))",
    "ripe_avocado_limit version 2": "!(key in groups.ripe_avocados) || order == 0 || (has(record.on_hand) && (double(record.on_hand) + double(order) <= double(values.expected_sales)))",
    "stock_count_age_check own": "((has(category.max_count_age_hours)) && (has(record.moment__counted)) && (!((0.0 - record.moment__counted) > double(category.max_count_age_hours))))",
    "stock_count_age_check version 1": "((has(category.max_count_age_hours)) && (has(record.moment__counted)) && (!((0.0 - record.moment__counted) > double(category.max_count_age_hours))))",
    "stock_count_age_check version 2": "((has(category.max_count_age_hours)) && (has(record.moment__counted)) && (!((0.0 - record.moment__counted) > double(category.max_count_age_hours))))",
  },
}
`;

